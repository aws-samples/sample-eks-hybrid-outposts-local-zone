MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="EDGEMESH"

--EDGEMESH
Content-Type: application/node.eks.aws

---
apiVersion: node.eks.aws/v1alpha1
kind: NodeConfig
spec:
  cluster:
    name: ${cluster_name}
    apiServerEndpoint: ${api_server_endpoint}
    certificateAuthority: ${certificate_data}
    cidr: ${service_cidr}
  kubelet:
    flags:
      - --node-labels=${node_labels}

--EDGEMESH--
