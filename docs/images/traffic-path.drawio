<mxfile host="app.diagrams.net"><diagram id="d" name="Diagram"><mxGraphModel dx="1900" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="720" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c11" value="Cross-cluster request path: sleep (AWS Outposts) → helloworld-v2 (AWS Local Zone)" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#232F3E;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1400" height="30" as="geometry" /></mxCell><mxCell id="c12" value="Corporate data center · AWS Outposts rack · eks-outposts" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6B86;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="570" height="340" as="geometry" /></mxCell><mxCell id="c13" value="AWS Direct Connect location (PoP) · AWS global network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#232F3E;fontColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="50" width="560" height="340" as="geometry" /></mxCell><mxCell id="c14" value="AWS Local Zone us-east-1-mia-2 · eks-localzone" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="1190" y="50" width="690" height="340" as="geometry" /></mxCell><mxCell id="c15" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;sleep&lt;/b&gt;&lt;br&gt;app container&lt;br&gt;HTTP helloworld.sample:5000" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c17" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;Envoy sidecar&lt;/b&gt;&lt;br&gt;iptables → :15001&lt;br&gt;client mTLS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c19" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;Outposts node ENI&lt;/b&gt;&lt;br&gt;10.3.10.5&lt;br&gt;route 10.2.0.0/16 → pcx" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c21" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Service link&lt;/b&gt;&lt;br&gt;over AWS Direct Connect" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.direct_connect;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="56" height="56" as="geometry" /></mxCell><mxCell id="c23" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c24" value="&lt;b&gt;DX location (PoP)&lt;/b&gt;&lt;br&gt;AWS edge" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.edge_location;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="56" height="56" as="geometry" /></mxCell><mxCell id="c25" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c26" value="&lt;b&gt;AWS backbone&lt;/b&gt;&lt;br&gt;to the Local Zone" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.globe;" vertex="1" parent="1"><mxGeometry x="1070" y="150" width="56" height="56" as="geometry" /></mxCell><mxCell id="c27" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1205" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c28" value="&lt;b&gt;Local Zone node ENI&lt;/b&gt;&lt;br&gt;10.2.10.5 : 15443" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1215" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c29" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c30" value="&lt;b&gt;East-west gateway&lt;/b&gt;&lt;br&gt;hostPort 15443&lt;br&gt;AUTO_PASSTHROUGH (SNI)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1380" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c31" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1535" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;Envoy sidecar&lt;/b&gt;&lt;br&gt;helloworld-v2&lt;br&gt;server mTLS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1545" y="140" width="140" height="78" as="geometry" /></mxCell><mxCell id="c33" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="120" width="26" height="26" as="geometry" /></mxCell><mxCell id="c34" value="&lt;b&gt;helloworld-v2&lt;/b&gt;&lt;br&gt;app container&lt;br&gt;“Hello version: v2”" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1710" y="140" width="150" height="78" as="geometry" /></mxCell><mxCell id="c35" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c36" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c37" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c38" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c39" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c40" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c41" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c42" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c43" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#232F3E;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="c32" target="c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c44" value="Encryption" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#7D8998;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="255" width="100" height="20" as="geometry" /></mxCell><mxCell id="c45" value="Plaintext HTTP (localhost)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#AAB7B8;fontColor=#545B64;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="280" width="250" height="30" as="geometry" /></mxCell><mxCell id="c46" value="mTLS — one TLS session, encrypted end to end · the east-west gateway reads SNI only, never decrypts" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontColor=#DD344C;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="1315" height="30" as="geometry" /></mxCell><mxCell id="c47" value="Plaintext HTTP (localhost)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#AAB7B8;fontColor=#545B64;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1615" y="280" width="245" height="30" as="geometry" /></mxCell><mxCell id="c48" value="Response: same path in reverse, same 5-tuple, still encrypted" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#7D8998;strokeWidth=1;dashed=1;fontSize=10;fontColor=#545B64;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c34" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1785" y="345" /><mxPoint x="120" y="345" /></Array></mxGeometry></mxCell><mxCell id="c49" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=none;fontColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1860" height="260" as="geometry" /></mxCell><mxCell id="c50" value="&lt;b&gt;What happens at each hop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="900" height="24" as="geometry" /></mxCell><mxCell id="c51" value="&lt;b&gt;1&lt;/b&gt;  The app sends plain HTTP to &lt;i&gt;helloworld.sample:5000&lt;/i&gt;.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;  The sidecar intercepts it, selects the network-lz endpoint, and starts mTLS with the sleep workload identity (cluster-outposts CA).&lt;br&gt;&lt;b&gt;3&lt;/b&gt;  The packet leaves the Outposts node to the Local Zone node IP on TCP 15443 (VPC-A route 10.2.0.0/16 → VPC peering).&lt;br&gt;&lt;b&gt;4&lt;/b&gt;  Traffic exits the rack over the Outposts service link, carried on AWS Direct Connect.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;  It enters the AWS global network at the Direct Connect location (PoP).&lt;br&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="900" height="150" as="geometry" /></mxCell><mxCell id="c52" value="&lt;b&gt;6&lt;/b&gt;  The AWS backbone delivers it to the Local Zone. It does not hairpin through the parent Region.&lt;br&gt;&lt;b&gt;7&lt;/b&gt;  It arrives on the Local Zone node ENI, port 15443.&lt;br&gt;&lt;b&gt;8&lt;/b&gt;  The east-west gateway (hostPort) reads the SNI and forwards the bytes without decrypting.&lt;br&gt;&lt;b&gt;9&lt;/b&gt;  The helloworld-v2 sidecar completes the handshake and terminates mTLS.&lt;br&gt;&lt;b&gt;10&lt;/b&gt;  The app receives plain HTTP and replies “Hello version: v2”." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="900" height="150" as="geometry" /></mxCell><mxCell id="c53" value="&lt;b&gt;Local endpoint (v1):&lt;/b&gt; when Istio picks helloworld-v1, the request stays on the Outposts node, with mTLS between sidecars and no Direct Connect, PoP, or backbone hop." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="30" as="geometry" /></mxCell><mxCell id="c54" value="Copyright © 2026 Amazon.com and Affiliates. Licensed under CC BY 4.0." style="text;html=1;whiteSpace=wrap;fontSize=9;fontColor=#7D8998;fontStyle=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="685" width="900" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>